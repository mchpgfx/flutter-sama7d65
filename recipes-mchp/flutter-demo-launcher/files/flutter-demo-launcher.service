[Unit]
Description=Flutter demo launcher (menu + demo selection)
# NO Wants=/After=dev-dri-card0.device. Device units exist only for devices udev
# TAGs with "systemd", and this image's 99-systemd.rules tags tty/block/net/sound/usb
# but nothing in the drm subsystem, so dev-dri-card0.device never activates and this
# unit sat waiting on it forever. The launcher polls for /dev/dri/card* itself.
After=systemd-udev-trigger.service
# The governor unit pins 1 GHz; the board otherwise idles at 90 MHz and the first
# frames would render at a fraction of full clock.
After=cpufreq-performance.service

[Service]
Type=simple
ExecStart=/usr/bin/flutter-demo-launcher
# Override the pinned connector without editing the script, e.g. for a DSI panel.
# Environment=DEMO_CONNECTOR=DSI-1
Restart=always
RestartSec=2s
# The script manages its own child processes; kill the whole group on stop so a
# homescreen instance cannot outlive the supervisor and keep DRM master.
KillMode=control-group
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
